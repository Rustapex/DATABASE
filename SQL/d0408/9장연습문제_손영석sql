desc professor;

-- 급여 많은 순서부터 정렬 / 후 5행만 자르기
select name, pay
from professor
order by pay desc
fetch first 5 rows only;

-- 급여 많은 순서부터 순위, 이름, 급여 출력
select rank() over(order by pay desc) ranking,
    name,
    pay 
    from professor;

select Ranking, Name, Pay
from (
    select rank() over(order by pay desc) ranking, 
    name,
    pay
    from professor)
where ranking <= 5;


