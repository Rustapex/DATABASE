-- 교수번호 순서 오름차순으로 교수번호, 이름, pay 출력
desc professor;
select profno, name, pay
from professor
order by profno;

select
    rank() over(order by profno) NUM,
 
    profno, name, pay, 
 
    sum(pay) over(
    partition by trunc(profno, -1)
    order by profno) "sum(pay)",
    
    round(sum(pay) over(
    partition by trunc(profno, -1)
    order by profno),1) "round(sum(pay),1)"
    
    from professor;
    
select trunc(profno, -1), profno
from professor;

select profno from professor;
    
